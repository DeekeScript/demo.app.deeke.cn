{
  "title": {
    "text": "设置",
    "fontSize": 17,
    "color": "#FFFFFF",
    "background": "#0B6E6A"
  },
  "style": {
    "background": "#EEF2F1",
    "padding": 10
  },
  "body": [
    {
      "type": "card",
      "style": {
        "padding": 12,
        "paddingBottom": 10,
        "gap": 6,
        "radius": 12,
        "background": "#FFFFFF",
        "marginBottom": 4,
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        { "type": "text", "text": "功能开关", "style": { "fontWeight": "bold", "fontSize": 15, "color": "#1A2B2A" } },
        { "type": "notice", "text": "关闭后对应动作不会执行" },
        { "type": "switch", "name": "enableLike", "label": "点赞", "size": "sm", "onChange": "onAutoSave", "style": { "color": "#0B6E6A" } },
        { "type": "switch", "name": "enableComment", "label": "评论", "size": "sm", "onChange": "onAutoSave", "style": { "color": "#0B6E6A" } },
        { "type": "switch", "name": "enableDm", "label": "私信", "size": "sm", "onChange": "onAutoSave", "style": { "color": "#0B6E6A" } }
      ]
    },
    {
      "type": "card",
      "style": {
        "padding": 12,
        "gap": 8,
        "radius": 12,
        "background": "#FFFFFF",
        "marginBottom": 4,
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        { "type": "text", "text": "触发频率", "style": { "fontWeight": "bold", "fontSize": 15, "color": "#1A2B2A" } },
        { "type": "notice", "text": "遇到目标内容时执行该动作的概率，建议循序渐进" },
        {
          "type": "slider",
          "name": "likeRate",
          "label": "点赞概率",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "onChange": "onAutoSave",
          "style": { "color": "#0B6E6A" }
        },
        {
          "type": "slider",
          "name": "commentRate",
          "label": "评论概率",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "onChange": "onAutoSave",
          "style": { "color": "#0B6E6A" }
        },
        {
          "type": "slider",
          "name": "dmRate",
          "label": "私信概率",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "onChange": "onAutoSave",
          "style": { "color": "#0B6E6A" }
        },
        {
          "type": "slider",
          "name": "intervalSec",
          "label": "动作间隔",
          "min": 1,
          "max": 30,
          "step": 1,
          "unit": "秒",
          "onChange": "onAutoSave",
          "style": { "color": "#0B6E6A" }
        }
      ]
    },
    {
      "type": "card",
      "style": {
        "padding": 12,
        "gap": 8,
        "radius": 12,
        "background": "#FFFFFF",
        "marginBottom": 4,
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        { "type": "text", "text": "单次上限", "style": { "fontWeight": "bold", "fontSize": 15, "color": "#1A2B2A" } },
        { "type": "notice", "text": "单次运行达到上限后自动停止对应动作" },
        {
          "type": "slider",
          "name": "likeMax",
          "label": "点赞次数",
          "min": 0,
          "max": 200,
          "step": 5,
          "unit": "次",
          "onChange": "onAutoSave",
          "style": { "color": "#0B6E6A" }
        },
        {
          "type": "slider",
          "name": "commentMax",
          "label": "评论次数",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "次",
          "onChange": "onAutoSave",
          "style": { "color": "#0B6E6A" }
        },
        {
          "type": "slider",
          "name": "dmMax",
          "label": "私信次数",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "次",
          "onChange": "onAutoSave",
          "style": { "color": "#0B6E6A" }
        }
      ]
    },
    {
      "type": "card",
      "style": {
        "padding": 12,
        "gap": 6,
        "radius": 12,
        "background": "#FFFFFF",
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        { "type": "text", "text": "关键词", "style": { "fontWeight": "bold", "fontSize": 15, "color": "#1A2B2A" } },
        {
          "type": "textarea",
          "name": "keywords",
          "label": "匹配关键词",
          "hint": "每行一个，命中后才执行动作",
          "minLines": 3,
          "variant": "box",
          "size": "sm",
          "onChange": "onAutoSave",
          "onBlur": "onAutoSave"
        },
        {
          "type": "textarea",
          "name": "excludeKeywords",
          "label": "排除关键词",
          "hint": "每行一个，命中则跳过",
          "minLines": 2,
          "variant": "box",
          "size": "sm",
          "onChange": "onAutoSave",
          "onBlur": "onAutoSave"
        }
      ]
    }
  ]
}
