{
  "title": {
    "text": "适配下载",
    "fontSize": 17,
    "color": "#FFFFFF",
    "background": "#0B6E6A"
  },
  "style": {
    "background": "#EEF2F1",
    "padding": 10
  },
  "body": [
    {
      "type": "card",
      "showIf": "showEmpty",
      "style": {
        "padding": 12,
        "gap": 6,
        "radius": 12,
        "background": "#FFFFFF",
        "marginBottom": 5,
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        { "type": "text", "text": "暂无适配信息", "style": { "fontWeight": "bold", "fontSize": 15, "color": "#1A2B2A" } },
        { "type": "notice", "text": "{{emptyHint}}" }
      ]
    },
    {
      "type": "card",
      "showIf": "showMain",
      "style": {
        "padding": 12,
        "gap": 8,
        "radius": 12,
        "background": "#FFFFFF",
        "marginBottom": 5,
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        {
          "type": "text",
          "text": "目标应用",
          "style": { "fontSize": 12, "color": "#7A8A88" }
        },
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            { "type": "text", "text": "{{appName}}", "style": { "weight": 1, "fontWeight": "bold", "fontSize": 17, "color": "#1A2B2A" } },
            {
              "type": "tag",
              "text": "{{compatTag}}",
              "style": { "background": "{{compatTagBg}}", "color": "{{compatTagColor}}", "radius": 4 }
            }
          ]
        },
        { "type": "notice", "text": "{{packageLine}}", "showIf": "hasPackage" },
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            { "type": "text", "text": "本机状态", "style": { "fontSize": 13, "color": "#7A8A88" } },
            {
              "type": "tag",
              "text": "{{localTag}}",
              "style": { "background": "{{localTagBg}}", "color": "{{localTagColor}}", "radius": 4 }
            }
          ]
        },
        { "type": "notice", "text": "{{localDetail}}" },
        {
          "type": "button",
          "text": "打开官方下载页",
          "size": "sm",
          "showIf": "showOfficial",
          "onTap": "onOpenOfficial",
          "style": { "background": "#F3F7F6", "color": "#0B6E6A", "radius": 8, "width": "100%" }
        }
      ]
    },
    {
      "type": "card",
      "showIf": "showVersions",
      "style": {
        "padding": 10,
        "gap": 8,
        "radius": 12,
        "background": "#FFFFFF",
        "marginBottom": 5,
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        { "type": "text", "text": "支持的版本", "style": { "fontWeight": "bold", "fontSize": 15, "color": "#1A2B2A" } },
        {
          "type": "list",
          "bind": "versions",
          "style": { "gap": 4 },
          "item": {
            "type": "card",
            "style": { "padding": 10, "radius": 10, "background": "#F7FAF9" },
            "children": [
              {
                "type": "row",
                "style": { "valign": "center", "gap": 8 },
                "children": [
                  {
                    "type": "column",
                    "style": { "weight": 1, "gap": 2 },
                    "children": [
                      {
                        "type": "row",
                        "style": { "valign": "center", "gap": 6 },
                        "children": [
                          { "type": "text", "text": "{{item.versionText}}", "style": { "fontWeight": "bold", "fontSize": 14 } },
                          {
                            "type": "tag",
                            "text": "推荐",
                            "showIf": "item.isRecommended",
                            "style": { "background": "#E8F6F4", "color": "#0B6E6A", "radius": 4 }
                          }
                        ]
                      },
                      { "type": "notice", "text": "{{item.note}}", "showIf": "item.hasNote" },
                      { "type": "notice", "text": "{{item.sourceLine}}", "showIf": "item.hasSource" }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "去下载",
                    "size": "sm",
                    "showIf": "item.hasDownload",
                    "onTap": "onDownloadVersion",
                    "style": { "background": "#0B6E6A", "color": "#FFFFFF", "radius": 8, "paddingLeft": 12, "paddingRight": 12 }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "type": "card",
      "showIf": "showNote",
      "style": {
        "padding": 10,
        "gap": 4,
        "radius": 12,
        "background": "#FFFFFF",
        "marginBottom": 5,
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        { "type": "text", "text": "适配说明", "style": { "fontWeight": "bold", "fontSize": 15, "color": "#1A2B2A" } },
        { "type": "notice", "text": "{{note}}" }
      ]
    },
    {
      "type": "card",
      "showIf": "showMain",
      "style": {
        "padding": 10,
        "gap": 4,
        "radius": 12,
        "background": "#FFF8F0",
        "marginBottom": 5,
        "borderWidth": 1,
        "borderColor": "#F0E0C8"
      },
      "children": [
        { "type": "text", "text": "重要提醒", "style": { "fontWeight": "bold", "fontSize": 14, "color": "#8A5A20" } },
        { "type": "notice", "text": "{{autoUpdateTip}}" }
      ]
    },
    {
      "type": "card",
      "showIf": "showMain",
      "style": {
        "padding": 10,
        "gap": 4,
        "radius": 12,
        "background": "#FFFFFF",
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        { "type": "notice", "text": "{{disclaimer}}" }
      ]
    }
  ]
}
