{
  "title": {
    "text": "诊断日志",
    "fontSize": 17,
    "color": "#FFFFFF",
    "background": "#FF2442"
  },
  "style": {
    "background": "#FFF5F5",
    "padding": 10
  },
  "body": [
    {
      "type": "card",
      "style": {
        "padding": 10,
        "gap": 8,
        "radius": 12,
        "background": "#FFFFFF",
        "marginBottom": 5,
        "borderWidth": 1,
        "borderColor": "#F5D0D0"
      },
      "children": [
        { "type": "text", "text": "日志文件", "style": { "fontWeight": "bold", "fontSize": 15, "color": "#1A2B2A" } },
        { "type": "notice", "text": "按日生成日志文件，可将对应文件分享给客服。" },
        { "type": "notice", "text": "{{summaryText}}", "style": { "color": "#8A6A6A" } },
        {
          "type": "button",
          "text": "清空日志",
          "size": "sm",
          "onTap": "onClear",
          "style": { "background": "#FFF1E8", "color": "#C65A12", "radius": 8, "width": "100%" }
        },
        {
          "type": "notice",
          "showIf": "hint",
          "text": "{{hint}}",
          "style": { "color": "#FF2442" }
        }
      ]
    },
    {
      "type": "card",
      "style": {
        "padding": 10,
        "gap": 8,
        "radius": 12,
        "background": "#FFFFFF",
        "borderWidth": 1,
        "borderColor": "#F5D0D0"
      },
      "children": [
        {
          "type": "list",
          "bind": "files",
          "style": { "gap": 4 },
          "item": {
            "type": "row",
            "style": {
              "valign": "center",
              "gap": 8,
              "padding": 10,
              "radius": 8,
              "background": "#F7FAF9",
              "borderWidth": 1,
              "borderColor": "#F5D0D0"
            },
            "children": [
              {
                "type": "column",
                "style": { "weight": 1, "gap": 2 },
                "children": [
                  {
                    "type": "text",
                    "text": "{{item.title}}",
                    "style": { "fontSize": 14, "fontWeight": "bold", "color": "#1A2B2A" }
                  },
                  {
                    "type": "notice",
                    "text": "{{item.detail}}",
                    "style": { "color": "#8A6A6A" }
                  }
                ]
              },
              {
                "type": "button",
                "text": "分享",
                "size": "sm",
                "onTap": "onShareFile",
                "style": { "background": "#FF2442", "color": "#FFFFFF", "radius": 8 }
              }
            ]
          }
        },
        { "type": "empty", "text": "暂无日志文件", "showIf": "empty" }
      ]
    },
    {
      "type": "dialog",
      "showIf": "clearConfirmOpen",
      "title": "清空日志",
      "text": "确定清空全部日志文件吗？此操作不可恢复。",
      "confirmText": "清空",
      "cancelText": "取消",
      "onConfirm": "onConfirmClear",
      "onCancel": "onCancelClear",
      "style": { "color": "#FF2442" }
    }
  ]
}
