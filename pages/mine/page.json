{
  "title": {
    "text": "我的",
    "fontSize": 17,
    "color": "#FFFFFF",
    "background": "#0B6E6A"
  },
  "style": {
    "background": "#F3F6F5",
    "padding": 12
  },
  "body": [
    {
      "type": "card",
      "style": { "padding": 16, "gap": 8, "radius": 14, "background": "#FFFFFF", "marginBottom": 4 },
      "children": [
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            { "type": "text", "text": "{{statusTitle}}", "style": { "weight": 1, "fontWeight": "bold", "fontSize": 16 } },
            {
              "type": "button",
              "text": "开通",
              "size": "sm",
              "onTap": "onGoPay",
              "style": { "background": "#0B6E6A", "color": "#FFFFFF", "radius": 8 }
            }
          ]
        },
        { "type": "notice", "text": "{{statusDetail}}" }
      ]
    },
    {
      "type": "card",
      "style": { "padding": 14, "gap": 12, "radius": 14, "background": "#FFFFFF", "marginBottom": 4 },
      "children": [
        { "type": "text", "text": "权限", "style": { "fontWeight": "bold", "fontSize": 15 } },
        {
          "type": "row",
          "style": { "valign": "center" },
          "children": [
            { "type": "text", "text": "无障碍", "style": { "weight": 1, "fontSize": 14 } },
            { "type": "tag", "text": "{{accessText}}", "style": { "background": "{{accessBg}}", "color": "{{accessColor}}", "radius": 6 } },
            {
              "type": "button",
              "text": "去开启",
              "size": "sm",
              "onTap": "onOpenGuide",
              "style": { "background": "#F0F4F3", "color": "#0B6E6A", "radius": 8 }
            }
          ]
        },
        {
          "type": "row",
          "style": { "valign": "center" },
          "children": [
            { "type": "text", "text": "悬浮窗", "style": { "weight": 1, "fontSize": 14 } },
            { "type": "tag", "text": "{{floatText}}", "style": { "background": "{{floatBg}}", "color": "{{floatColor}}", "radius": 6 } },
            {
              "type": "button",
              "text": "去开启",
              "size": "sm",
              "onTap": "onOpenFloat",
              "style": { "background": "#F0F4F3", "color": "#0B6E6A", "radius": 8 }
            }
          ]
        },
        {
          "type": "row",
          "style": { "valign": "center" },
          "children": [
            {
              "type": "column",
              "style": { "weight": 1, "gap": 2 },
              "children": [
                { "type": "text", "text": "省电限制", "style": { "fontSize": 14 } },
                { "type": "notice", "text": "允许高耗电，避免被系统杀掉" }
              ]
            },
            {
              "type": "button",
              "text": "去设置",
              "size": "sm",
              "onTap": "onBattery",
              "style": { "background": "#FFF6E8", "color": "#A35B00", "radius": 8 }
            }
          ]
        }
      ]
    },
    {
      "type": "card",
      "style": { "padding": 14, "gap": 8, "radius": 14, "background": "#FFFFFF", "marginBottom": 4 },
      "children": [
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            { "type": "text", "text": "版本", "style": { "weight": 1, "fontWeight": "bold", "fontSize": 15 } },
            { "type": "text", "text": "{{localVersion}}", "style": { "fontSize": 13, "color": "#667" } }
          ]
        },
        { "type": "notice", "text": "{{updateHint}}" },
        {
          "type": "row",
          "style": { "gap": 8 },
          "children": [
            {
              "type": "button",
              "text": "检查更新",
              "size": "sm",
              "onTap": "onCheckUpdate",
              "style": { "weight": 1, "background": "#F0F4F3", "color": "#0B6E6A", "radius": 8 }
            },
            {
              "type": "button",
              "text": "立即更新",
              "size": "sm",
              "showIf": "hasUpdate",
              "onTap": "onDoUpdate",
              "style": { "weight": 1, "background": "#0B6E6A", "color": "#FFFFFF", "radius": 8 }
            }
          ]
        }
      ]
    },
    {
      "type": "card",
      "style": { "padding": 14, "gap": 8, "radius": 14, "background": "#FFFFFF", "marginBottom": 4 },
      "children": [
        { "type": "text", "text": "客服", "style": { "fontWeight": "bold", "fontSize": 15 } },
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            { "type": "text", "text": "微信", "style": { "fontSize": 13, "color": "#667" } },
            { "type": "text", "text": "{{supportWechat}}", "style": { "weight": 1, "fontSize": 14, "color": "#223", "fontWeight": "bold" } },
            {
              "type": "image",
              "src": "img/copy.svg",
              "onTap": "onCopyWechat",
              "style": { "width": 22, "height": 22 }
            }
          ]
        },
        { "type": "notice", "text": "添加好友时请备注「D0001咨询」" }
      ]
    },
    {
      "type": "card",
      "style": { "padding": 14, "gap": 8, "radius": 14, "background": "#FFFFFF" },
      "children": [
        { "type": "text", "text": "设备", "style": { "fontWeight": "bold", "fontSize": 15 } },
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            { "type": "text", "text": "设备号", "style": { "fontSize": 13, "color": "#667" } },
            { "type": "text", "text": "{{deviceId}}", "style": { "weight": 1, "fontSize": 13, "color": "#223" } },
            {
              "type": "image",
              "src": "img/copy.svg",
              "onTap": "onCopyDevice",
              "style": { "width": 22, "height": 22 }
            }
          ]
        },
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            { "type": "text", "text": "APP代码", "style": { "fontSize": 13, "color": "#667" } },
            { "type": "text", "text": "{{toolCode}}", "style": { "weight": 1, "fontSize": 13, "color": "#223" } }
          ]
        }
      ]
    }
  ],
  "popups": [
    {
      "showIf": "guideOpen",
      "position": "center",
      "width": "88%",
      "style": { "radius": 14, "background": "#FFFFFF", "padding": 12, "gap": 10, "height": "wrap" },
      "body": [
        {
          "type": "row",
          "style": { "valign": "center" },
          "children": [
            { "type": "space", "style": { "width": 22 } },
            {
              "type": "text",
              "text": "如何开启无障碍",
              "style": { "weight": 1, "fontWeight": "bold", "fontSize": 16, "color": "#223", "align": "center" }
            },
            {
              "type": "image",
              "src": "img/close.svg",
              "onTap": "onCloseGuide",
              "style": { "width": 22, "height": 22 }
            }
          ]
        },
        {
          "type": "column",
          "style": { "background": "#FFFFFF", "radius": 10, "padding": 10, "gap": 8, "borderWidth": 1, "borderColor": "#E6EEEE" },
          "children": [
            {
              "type": "text",
              "text": "已下载的应用",
              "style": { "fontSize": 14, "fontWeight": "bold", "color": "#223", "align": "left" }
            },
            {
              "type": "row",
              "style": { "valign": "center", "gap": 8, "background": "#F7FAF9", "radius": 8, "padding": 10 },
              "children": [
                {
                  "type": "text",
                  "text": "{{guideAppName}}",
                  "style": { "weight": 1, "fontSize": 14, "fontWeight": "bold", "color": "#223" }
                },
                {
                  "type": "text",
                  "text": "已关闭 >",
                  "style": { "fontSize": 13, "color": "#889999" }
                }
              ]
            }
          ]
        },
        {
          "type": "button",
          "text": "去打开",
          "size": "sm",
          "onTap": "onOpenAccessibility",
          "style": { "background": "#0B6E6A", "color": "#FFFFFF", "width": "100%", "radius": 8 }
        }
      ]
    },
    {
      "showIf": "updateOpen",
      "position": "center",
      "title": "{{updateTitle}}",
      "width": "88%",
      "closeOnMask": false,
      "style": { "radius": 14, "background": "#FFFFFF" },
      "body": [
        { "type": "notice", "text": "{{updateVersionLine}}" },
        { "type": "notice", "text": "{{updateSizeLine}}", "showIf": "hasUpdateSize" },
        { "type": "space", "height": 6 },
        { "type": "text", "text": "{{updateChangelog}}", "style": { "fontSize": 13, "color": "#334" } },
        { "type": "space", "height": 10 },
        {
          "type": "row",
          "style": { "gap": 8 },
          "children": [
            {
              "type": "button",
              "text": "以后再说",
              "size": "sm",
              "showIf": "canSkipUpdate",
              "onTap": "onSkipUpdate",
              "style": { "weight": 1, "background": "#F0F4F3", "color": "#445" }
            },
            {
              "type": "button",
              "text": "{{updateConfirmText}}",
              "size": "sm",
              "onTap": "onDoUpdate",
              "style": { "weight": 1, "background": "#0B6E6A", "color": "#FFFFFF" }
            }
          ]
        }
      ]
    }
  ]
}
