{
  "title": {
    "hidden": true
  },
  "style": {
    "background": "#EEF2F1",
    "padding": 0
  },
  "body": [
    {
      "type": "column",
      "style": { "background": "#0B6E6A", "padding": 12 },
      "children": [
        {
          "type": "row",
          "style": { "valign": "center" },
          "children": [
            {
              "type": "text",
              "text": "话术",
              "style": { "weight": 1, "color": "#FFFFFF", "fontSize": 17, "fontWeight": "bold" }
            },
            {
              "type": "image",
              "src": "img/add.svg",
              "onTap": "onOpenAdd",
              "style": { "width": 26, "height": 26 }
            }
          ]
        }
      ]
    },
    {
      "type": "column",
      "style": { "padding": 12, "gap": 8 },
      "children": [
        {
          "type": "row",
          "style": { "gap": 8, "valign": "center" },
          "children": [
            {
              "type": "button",
              "text": "全部",
              "size": "sm",
              "onTap": "onFilterAll",
              "style": { "background": "{{filterAllBg}}", "color": "{{filterAllColor}}", "radius": 8 }
            },
            {
              "type": "button",
              "text": "私信",
              "size": "sm",
              "onTap": "onFilterDm",
              "style": { "background": "{{filterDmBg}}", "color": "{{filterDmColor}}", "radius": 8 }
            },
            {
              "type": "button",
              "text": "评论",
              "size": "sm",
              "onTap": "onFilterComment",
              "style": { "background": "{{filterCommentBg}}", "color": "{{filterCommentColor}}", "radius": 8 }
            }
          ]
        },
        {
          "type": "list",
          "bind": "rows",
          "item": {
            "type": "card",
            "style": {
              "padding": 12,
              "marginBottom": 8,
              "radius": 12,
              "background": "#FFFFFF",
              "borderWidth": 1,
              "borderColor": "#E2EAEA"
            },
            "children": [
              {
                "type": "row",
                "style": { "gap": 8, "valign": "center" },
                "children": [
                  {
                    "type": "tag",
                    "text": "{{item.typeLabel}}",
                    "style": { "background": "{{item.typeBg}}", "color": "{{item.typeColor}}", "radius": 4 }
                  },
                  {
                    "type": "column",
                    "style": { "weight": 1, "gap": 2 },
                    "children": [
                      { "type": "text", "text": "{{item.content}}", "style": { "fontSize": 14, "color": "#1A2B2A" } },
                      { "type": "notice", "text": "{{item.statusText}}" }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "⋮",
                    "size": "sm",
                    "onTap": "onMore",
                    "style": { "background": "#F3F7F6", "color": "#445", "radius": 8, "fontSize": 16 }
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "card",
          "showIf": "empty",
          "style": {
            "padding": 28,
            "gap": 6,
            "radius": 12,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA",
            "align": "center"
          },
          "children": [
            { "type": "text", "text": "暂无话术", "style": { "fontWeight": "bold", "fontSize": 15, "color": "#1A2B2A", "align": "center" } },
            { "type": "notice", "text": "点击右上角添加，建议先准备私信与评论各若干条" }
          ]
        }
      ]
    },
    {
      "type": "actionSheet",
      "showIf": "menuOpenEnabled",
      "title": "话术操作",
      "items": [
        { "text": "停用", "value": "disable" },
        { "text": "删除", "value": "delete" }
      ],
      "onChange": "onMenuAction",
      "cancelText": "取消"
    },
    {
      "type": "actionSheet",
      "showIf": "menuOpenDisabled",
      "title": "话术操作",
      "items": [
        { "text": "启用", "value": "enable" },
        { "text": "删除", "value": "delete" }
      ],
      "onChange": "onMenuAction",
      "cancelText": "取消"
    }
  ],
  "popups": [
    {
      "showIf": "addOpen",
      "position": "bottom",
      "style": { "radius": 16, "background": "#FFFFFF", "padding": 14, "gap": 12 },
      "body": [
        {
          "type": "row",
          "style": { "valign": "center", "width": "100%" },
          "children": [
            { "type": "space", "style": { "width": 22 } },
            {
              "type": "text",
              "text": "添加话术",
              "style": { "weight": 1, "fontWeight": "bold", "fontSize": 16, "color": "#1A2B2A", "align": "center" }
            },
            {
              "type": "image",
              "src": "img/close.svg",
              "onTap": "onCloseAdd",
              "style": { "width": 22, "height": 22 }
            }
          ]
        },
        {
          "type": "radio",
          "name": "newType",
          "label": "类型",
          "options": [
            { "label": "私信", "value": "dm" },
            { "label": "评论", "value": "comment" }
          ],
          "style": { "color": "#0B6E6A" }
        },
        {
          "type": "textarea",
          "name": "newContent",
          "label": "内容",
          "hint": "输入一条话术",
          "minLines": 3,
          "variant": "box",
          "size": "sm"
        },
        {
          "type": "switch",
          "name": "newEnabled",
          "label": "启用状态",
          "size": "sm",
          "style": { "color": "#0B6E6A" }
        },
        {
          "type": "button",
          "text": "保存",
          "size": "md",
          "onTap": "onAdd",
          "style": { "background": "#0B6E6A", "color": "#FFFFFF", "radius": 10, "width": "100%" }
        }
      ]
    }
  ]
}
