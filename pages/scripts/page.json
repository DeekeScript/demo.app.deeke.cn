{
  "title": {
    "text": "话术",
    "fontSize": 17,
    "color": "#FFFFFF",
    "background": "#0B6E6A",
    "right": [
      {
        "icon": "{{addIcon}}",
        "text": "{{addText}}",
        "onTap": "onOpenAdd"
      }
    ]
  },
  "style": {
    "background": "#EEF2F1",
    "padding": 10
  },
  "body": [
    {
      "type": "card",
      "style": {
        "padding": 4,
        "radius": 14,
        "background": "#E4EEEC",
        "marginBottom": 8,
        "borderWidth": 0
      },
      "children": [
        {
          "type": "row",
          "style": {
            "gap": 4,
            "valign": "stretch"
          },
          "children": [
            {
              "type": "column",
              "onTap": "onModePlatform",
              "style": {
                "weight": 1,
                "padding": 10,
                "radius": 11,
                "background": "{{modePlatformBg}}",
                "align": "center",
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "自定义话术",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 14,
                    "color": "{{modePlatformColor}}",
                    "align": "center"
                  }
                },
                {
                  "type": "text",
                  "text": "固定文案随机发送",
                  "style": {
                    "fontSize": 11,
                    "color": "{{modePlatformSub}}",
                    "align": "center"
                  }
                }
              ]
            },
            {
              "type": "column",
              "onTap": "onModeSmart",
              "style": {
                "weight": 1,
                "padding": 10,
                "radius": 11,
                "background": "{{modeSmartBg}}",
                "align": "center",
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "AI智能话术",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 14,
                    "color": "{{modeSmartColor}}",
                    "align": "center"
                  }
                },
                {
                  "type": "text",
                  "text": "按场景实时生成",
                  "style": {
                    "fontSize": 11,
                    "color": "{{modeSmartSub}}",
                    "align": "center"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "column",
      "showIf": "showPlatform",
      "style": {
        "gap": 8
      },
      "children": [
        {
          "type": "row",
          "style": {
            "gap": 8,
            "valign": "center"
          },
          "children": [
            {
              "type": "button",
              "text": "全部",
              "size": "sm",
              "onTap": "onFilterAll",
              "style": {
                "background": "{{filterAllBg}}",
                "color": "{{filterAllColor}}",
                "radius": 8
              }
            },
            {
              "type": "button",
              "text": "私信",
              "size": "sm",
              "onTap": "onFilterDm",
              "style": {
                "background": "{{filterDmBg}}",
                "color": "{{filterDmColor}}",
                "radius": 8
              }
            },
            {
              "type": "button",
              "text": "评论",
              "size": "sm",
              "onTap": "onFilterComment",
              "style": {
                "background": "{{filterCommentBg}}",
                "color": "{{filterCommentColor}}",
                "radius": 8
              }
            }
          ]
        },
        {
          "type": "list",
          "bind": "rows",
          "style": {
            "gap": 6
          },
          "item": {
            "type": "card",
            "style": {
              "padding": 10,
              "radius": 12,
              "background": "#FFFFFF",
              "borderWidth": 1,
              "borderColor": "#E2EAEA"
            },
            "children": [
              {
                "type": "row",
                "style": {
                  "gap": 8,
                  "valign": "center"
                },
                "children": [
                  {
                    "type": "tag",
                    "text": "{{item.typeLabel}}",
                    "style": {
                      "background": "{{item.typeBg}}",
                      "color": "{{item.typeColor}}",
                      "radius": 4
                    }
                  },
                  {
                    "type": "column",
                    "style": {
                      "weight": 1,
                      "gap": 2
                    },
                    "children": [
                      {
                        "type": "text",
                        "text": "{{item.content}}",
                        "style": {
                          "fontSize": 14,
                          "color": "#1A2B2A"
                        }
                      },
                      {
                        "type": "notice",
                        "text": "{{item.statusText}}"
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "text": "⋮",
                    "size": "sm",
                    "onTap": "onMore",
                    "style": {
                      "background": "#F3F7F6",
                      "color": "#445",
                      "radius": 8,
                      "fontSize": 16
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "card",
          "showIf": "empty",
          "style": {
            "padding": 22,
            "gap": 6,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA",
            "align": "center"
          },
          "children": [
            {
              "type": "text",
              "text": "暂无话术",
              "style": {
                "fontWeight": "bold",
                "fontSize": 15,
                "color": "#1A2B2A",
                "align": "center"
              }
            },
            {
              "type": "notice",
              "text": "点右上角添加，建议私信和评论都准备几条"
            }
          ]
        }
      ]
    },
    {
      "type": "column",
      "showIf": "showSmart",
      "style": {
        "gap": 10
      },
      "children": [
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 8,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "text",
              "text": "发送策略",
              "style": {
                "fontWeight": "bold",
                "fontSize": 15,
                "color": "#1A2B2A"
              }
            },
            {
              "type": "notice",
              "text": "关闭后，私信仍使用自定义话术库里的固定文案"
            },
            {
              "type": "switch",
              "name": "dmSmart",
              "label": "私信启用AI智能话术",
              "size": "sm",
              "onChange": "onSmartSave",
              "style": {
                "color": "#0B6E6A"
              }
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 10,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "row",
              "style": {
                "valign": "center"
              },
              "children": [
                {
                  "type": "text",
                  "text": "大模型",
                  "style": {
                    "weight": 1,
                    "fontWeight": "bold",
                    "fontSize": 15,
                    "color": "#1A2B2A"
                  }
                },
                {
                  "type": "text",
                  "text": "如何获取API Key？",
                  "onTap": "onOpenApiKeyGuide",
                  "style": {
                    "fontSize": 12,
                    "color": "#0B6E6A"
                  }
                }
              ]
            },
            {
              "type": "picker",
              "name": "provider",
              "label": "平台",
              "options": [
                {
                  "label": "DeepSeek",
                  "value": "deepseek"
                },
                {
                  "label": "通义",
                  "value": "qwen"
                },
                {
                  "label": "智谱",
                  "value": "zhipu"
                },
                {
                  "label": "Kimi",
                  "value": "moonshot"
                },
                {
                  "label": "OpenAI",
                  "value": "openai"
                },
                {
                  "label": "自定义",
                  "value": "custom"
                }
              ],
              "onChange": "onProviderChange",
              "style": {
                "color": "#0B6E6A"
              }
            },
            {
              "type": "input",
              "name": "apiKey",
              "label": "API Key",
              "hint": "粘贴平台密钥",
              "password": true,
              "variant": "box",
              "onBlur": "onSmartSave"
            },
            {
              "type": "input",
              "name": "model",
              "label": "模型",
              "hint": "例如 deepseek-flash",
              "variant": "box",
              "onBlur": "onSmartSave"
            },
            {
              "type": "input",
              "name": "baseUrl",
              "label": "接口地址",
              "hint": "OpenAI 兼容的 chat/completions 地址",
              "variant": "box",
              "showIf": "showCustomUrl",
              "onBlur": "onSmartSave"
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 4,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "text",
              "text": "话术设置",
              "style": {
                "fontWeight": "bold",
                "fontSize": 15,
                "color": "#1A2B2A"
              }
            },
            {
              "type": "notice",
              "text": "点选下方选项，选中项为主色底、白字。"
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 10,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "column",
              "style": {
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "行业",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 15,
                    "color": "#1A2B2A"
                  }
                },
                {
                  "type": "notice",
                  "text": "决定话术的行业语境，选「自定义」可手填"
                }
              ]
            },
            {
              "type": "grid",
              "bind": "industryOpts",
              "columns": 3,
              "style": {
                "gap": 8
              },
              "item": {
                "type": "card",
                "value": "{{item.value}}",
                "onTap": "onPickChip",
                "style": {
                  "padding": 10,
                  "radius": 10,
                  "gap": 0,
                  "align": "center",
                  "background": "{{item.bg}}",
                  "borderWidth": 1,
                  "borderColor": "{{item.border}}"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "{{item.label}}",
                    "style": {
                      "fontSize": 12,
                      "align": "center",
                      "color": "{{item.color}}"
                    }
                  }
                ]
              }
            },
            {
              "type": "input",
              "name": "industryCustom",
              "label": "自定义行业",
              "hint": "例如：孕婴、宠物、减脂",
              "variant": "box",
              "showIf": "showIndustryCustom",
              "onBlur": "onSmartSave"
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 10,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "column",
              "style": {
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "句式",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 15,
                    "color": "#1A2B2A"
                  }
                },
                {
                  "type": "notice",
                  "text": "控制怎么说。默认陈述句，避免一堆问句"
                }
              ]
            },
            {
              "type": "grid",
              "bind": "sentenceOpts",
              "columns": 3,
              "style": {
                "gap": 8
              },
              "item": {
                "type": "card",
                "value": "{{item.value}}",
                "onTap": "onPickChip",
                "style": {
                  "padding": 10,
                  "radius": 10,
                  "gap": 0,
                  "align": "center",
                  "background": "{{item.bg}}",
                  "borderWidth": 1,
                  "borderColor": "{{item.border}}"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "{{item.label}}",
                    "style": {
                      "fontSize": 12,
                      "align": "center",
                      "color": "{{item.color}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 10,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "column",
              "style": {
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "语气",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 15,
                    "color": "#1A2B2A"
                  }
                },
                {
                  "type": "notice",
                  "text": "决定说话的感觉和距离感"
                }
              ]
            },
            {
              "type": "grid",
              "bind": "toneOpts",
              "columns": 2,
              "style": {
                "gap": 8
              },
              "item": {
                "type": "card",
                "value": "{{item.value}}",
                "onTap": "onPickChip",
                "style": {
                  "padding": 10,
                  "radius": 10,
                  "gap": 0,
                  "align": "center",
                  "background": "{{item.bg}}",
                  "borderWidth": 1,
                  "borderColor": "{{item.border}}"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "{{item.label}}",
                    "style": {
                      "fontSize": 12,
                      "align": "center",
                      "color": "{{item.color}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 10,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "column",
              "style": {
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "目的",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 15,
                    "color": "#1A2B2A"
                  }
                },
                {
                  "type": "notice",
                  "text": "这条话术想促成的下一步"
                }
              ]
            },
            {
              "type": "grid",
              "bind": "goalOpts",
              "columns": 3,
              "style": {
                "gap": 8
              },
              "item": {
                "type": "card",
                "value": "{{item.value}}",
                "onTap": "onPickChip",
                "style": {
                  "padding": 10,
                  "radius": 10,
                  "gap": 0,
                  "align": "center",
                  "background": "{{item.bg}}",
                  "borderWidth": 1,
                  "borderColor": "{{item.border}}"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "{{item.label}}",
                    "style": {
                      "fontSize": 12,
                      "align": "center",
                      "color": "{{item.color}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 10,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "column",
              "style": {
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "人称",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 15,
                    "color": "#1A2B2A"
                  }
                },
                {
                  "type": "notice",
                  "text": "你用什么身份跟对方说话"
                }
              ]
            },
            {
              "type": "grid",
              "bind": "personOpts",
              "columns": 3,
              "style": {
                "gap": 8
              },
              "item": {
                "type": "card",
                "value": "{{item.value}}",
                "onTap": "onPickChip",
                "style": {
                  "padding": 10,
                  "radius": 10,
                  "gap": 0,
                  "align": "center",
                  "background": "{{item.bg}}",
                  "borderWidth": 1,
                  "borderColor": "{{item.border}}"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "{{item.label}}",
                    "style": {
                      "fontSize": 12,
                      "align": "center",
                      "color": "{{item.color}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 10,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "column",
              "style": {
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "长度",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 15,
                    "color": "#1A2B2A"
                  }
                },
                {
                  "type": "notice",
                  "text": "评论和私信分别写多长"
                }
              ]
            },
            {
              "type": "grid",
              "bind": "lengthOpts",
              "columns": 2,
              "style": {
                "gap": 8
              },
              "item": {
                "type": "card",
                "value": "{{item.value}}",
                "onTap": "onPickChip",
                "style": {
                  "padding": 10,
                  "radius": 10,
                  "gap": 0,
                  "align": "center",
                  "background": "{{item.bg}}",
                  "borderWidth": 1,
                  "borderColor": "{{item.border}}"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "{{item.label}}",
                    "style": {
                      "fontSize": 12,
                      "align": "center",
                      "color": "{{item.color}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 10,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "column",
              "style": {
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "称呼",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 15,
                    "color": "#1A2B2A"
                  }
                },
                {
                  "type": "notice",
                  "text": "开头要不要带称呼"
                }
              ]
            },
            {
              "type": "grid",
              "bind": "addressOpts",
              "columns": 2,
              "style": {
                "gap": 8
              },
              "item": {
                "type": "card",
                "value": "{{item.value}}",
                "onTap": "onPickChip",
                "style": {
                  "padding": 10,
                  "radius": 10,
                  "gap": 0,
                  "align": "center",
                  "background": "{{item.bg}}",
                  "borderWidth": 1,
                  "borderColor": "{{item.border}}"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "{{item.label}}",
                    "style": {
                      "fontSize": 12,
                      "align": "center",
                      "color": "{{item.color}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 10,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "column",
              "style": {
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "表情",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 15,
                    "color": "#1A2B2A"
                  }
                },
                {
                  "type": "notice",
                  "text": "要不要带表情、带几个"
                }
              ]
            },
            {
              "type": "grid",
              "bind": "emojiOpts",
              "columns": 3,
              "style": {
                "gap": 8
              },
              "item": {
                "type": "card",
                "value": "{{item.value}}",
                "onTap": "onPickChip",
                "style": {
                  "padding": 10,
                  "radius": 10,
                  "gap": 0,
                  "align": "center",
                  "background": "{{item.bg}}",
                  "borderWidth": 1,
                  "borderColor": "{{item.border}}"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "{{item.label}}",
                    "style": {
                      "fontSize": 12,
                      "align": "center",
                      "color": "{{item.color}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 10,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "column",
              "style": {
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "获客方式",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 15,
                    "color": "#1A2B2A"
                  }
                },
                {
                  "type": "notice",
                  "text": "推销感强弱，从只互动到直接说明"
                }
              ]
            },
            {
              "type": "grid",
              "bind": "approachOpts",
              "columns": 2,
              "style": {
                "gap": 8
              },
              "item": {
                "type": "card",
                "value": "{{item.value}}",
                "onTap": "onPickChip",
                "style": {
                  "padding": 10,
                  "radius": 10,
                  "gap": 0,
                  "align": "center",
                  "background": "{{item.bg}}",
                  "borderWidth": 1,
                  "borderColor": "{{item.border}}"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "{{item.label}}",
                    "style": {
                      "fontSize": 12,
                      "align": "center",
                      "color": "{{item.color}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 10,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "column",
              "style": {
                "gap": 2
              },
              "children": [
                {
                  "type": "text",
                  "text": "评论重点",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 15,
                    "color": "#1A2B2A"
                  }
                },
                {
                  "type": "notice",
                  "text": "评论时抓住视频的哪一点"
                }
              ]
            },
            {
              "type": "grid",
              "bind": "focusOpts",
              "columns": 2,
              "style": {
                "gap": 8
              },
              "item": {
                "type": "card",
                "value": "{{item.value}}",
                "onTap": "onPickChip",
                "style": {
                  "padding": 10,
                  "radius": 10,
                  "gap": 0,
                  "align": "center",
                  "background": "{{item.bg}}",
                  "borderWidth": 1,
                  "borderColor": "{{item.border}}"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "{{item.label}}",
                    "style": {
                      "fontSize": 12,
                      "align": "center",
                      "color": "{{item.color}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "card",
          "style": {
            "padding": 12,
            "gap": 8,
            "radius": 14,
            "background": "#FFFFFF",
            "borderWidth": 1,
            "borderColor": "#E2EAEA"
          },
          "children": [
            {
              "type": "text",
              "text": "试生成",
              "style": {
                "fontWeight": "bold",
                "fontSize": 15,
                "color": "#1A2B2A"
              }
            },
            {
              "type": "card",
              "style": {
                "padding": 4,
                "radius": 10,
                "background": "#E4EEEC",
                "borderWidth": 0
              },
              "children": [
                {
                  "type": "row",
                  "style": {
                    "gap": 4
                  },
                  "children": [
                    {
                      "type": "button",
                      "text": "评论",
                      "size": "sm",
                      "onTap": "onTrialTabComment",
                      "style": {
                        "background": "{{trialCommentBg}}",
                        "color": "{{trialCommentColor}}",
                        "radius": 8,
                        "weight": 1
                      }
                    },
                    {
                      "type": "button",
                      "text": "私信",
                      "size": "sm",
                      "onTap": "onTrialTabDm",
                      "style": {
                        "background": "{{trialDmBg}}",
                        "color": "{{trialDmColor}}",
                        "radius": 8,
                        "weight": 1
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "column",
              "showIf": "showTrialComment",
              "style": {
                "gap": 8
              },
              "children": [
                {
                  "type": "notice",
                  "text": "填一段视频文案或场景，看看评论会怎么写"
                },
                {
                  "type": "textarea",
                  "name": "trialInput",
                  "hint": "例如：分享了三招提升短视频完播率",
                  "minLines": 2,
                  "variant": "box"
                }
              ]
            },
            {
              "type": "column",
              "showIf": "showTrialDm",
              "style": {
                "gap": 8
              },
              "children": [
                {
                  "type": "notice",
                  "text": "私信主要按对方评论来写，视频标题用来点明是在哪条视频下看到的"
                },
                {
                  "type": "textarea",
                  "name": "trialComment",
                  "label": "评论内容",
                  "hint": "对方在视频下的评论",
                  "minLines": 2,
                  "variant": "box"
                },
                {
                  "type": "input",
                  "name": "trialVideo",
                  "label": "视频标题",
                  "hint": "这条评论所在的视频，可空",
                  "variant": "box"
                },
                {
                  "type": "input",
                  "name": "trialNickname",
                  "label": "昵称",
                  "hint": "例如：小鹿",
                  "variant": "box"
                },
                {
                  "type": "picker",
                  "name": "trialGender",
                  "label": "性别",
                  "options": [
                    {
                      "label": "未知",
                      "value": "未知"
                    },
                    {
                      "label": "女",
                      "value": "女"
                    },
                    {
                      "label": "男",
                      "value": "男"
                    }
                  ],
                  "onChange": "onTrialGender",
                  "style": {
                    "color": "#0B6E6A"
                  }
                },
                {
                  "type": "input",
                  "name": "trialAge",
                  "label": "年龄",
                  "hint": "例如：26",
                  "variant": "box"
                }
              ]
            },
            {
              "type": "button",
              "text": "{{trialActionText}}",
              "size": "sm",
              "onTap": "onTrialGenerate",
              "style": {
                "background": "#0B6E6A",
                "color": "#FFFFFF",
                "radius": 10,
                "width": "100%"
              }
            },
            {
              "type": "card",
              "showIf": "showTrial",
              "style": {
                "padding": 10,
                "gap": 4,
                "radius": 10,
                "background": "#F6FAF9",
                "borderWidth": 1,
                "borderColor": "#D5EBE8"
              },
              "children": [
                {
                  "type": "text",
                  "text": "{{trialKind}}",
                  "style": {
                    "fontSize": 12,
                    "color": "#0B6E6A",
                    "fontWeight": "bold"
                  }
                },
                {
                  "type": "text",
                  "text": "{{trialText}}",
                  "style": {
                    "fontSize": 14,
                    "color": "#1A2B2A"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "actionSheet",
      "showIf": "menuOpenEnabled",
      "title": "话术操作",
      "items": [
        {
          "text": "停用",
          "value": "disable"
        },
        {
          "text": "删除",
          "value": "delete"
        }
      ],
      "onChange": "onMenuAction",
      "cancelText": "取消"
    },
    {
      "type": "actionSheet",
      "showIf": "menuOpenDisabled",
      "title": "话术操作",
      "items": [
        {
          "text": "启用",
          "value": "enable"
        },
        {
          "text": "删除",
          "value": "delete"
        }
      ],
      "onChange": "onMenuAction",
      "cancelText": "取消"
    }
  ],
  "popups": [
    {
      "showIf": "addOpen",
      "position": "bottom",
      "style": {
        "radius": 16,
        "background": "#FFFFFF",
        "padding": 10,
        "gap": 8
      },
      "body": [
        {
          "type": "row",
          "style": {
            "valign": "center",
            "width": "100%"
          },
          "children": [
            {
              "type": "space",
              "style": {
                "width": 22
              }
            },
            {
              "type": "text",
              "text": "添加话术",
              "style": {
                "weight": 1,
                "fontWeight": "bold",
                "fontSize": 16,
                "color": "#1A2B2A",
                "align": "center"
              }
            },
            {
              "type": "image",
              "src": "img/close.svg",
              "onTap": "onCloseAdd",
              "style": {
                "width": 22,
                "height": 22
              }
            }
          ]
        },
        {
          "type": "radio",
          "name": "newType",
          "label": "类型",
          "options": [
            {
              "label": "私信",
              "value": "dm"
            },
            {
              "label": "评论",
              "value": "comment"
            }
          ],
          "style": {
            "color": "#0B6E6A"
          }
        },
        {
          "type": "textarea",
          "name": "newContent",
          "label": "内容",
          "hint": "输入一条话术",
          "minLines": 3,
          "variant": "box",
          "size": "sm"
        },
        {
          "type": "switch",
          "name": "newEnabled",
          "label": "启用状态",
          "size": "sm",
          "style": {
            "color": "#0B6E6A"
          }
        },
        {
          "type": "button",
          "text": "保存",
          "size": "md",
          "onTap": "onAdd",
          "style": {
            "background": "#0B6E6A",
            "color": "#FFFFFF",
            "radius": 10,
            "width": "100%"
          }
        }
      ]
    }
  ]
}
