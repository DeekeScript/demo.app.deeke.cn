{
  "title": {
    "text": "工作台",
    "fontSize": 17,
    "color": "#FFFFFF",
    "background": "#0B6E6A"
  },
  "style": {
    "background": "#EEF2F1",
    "padding": 10
  },
  "body": [
    { "type": "activationCard", "id": "activationCard" },
    {
      "type": "card",
      "style": {
        "padding": 10,
        "gap": 8,
        "radius": 12,
        "background": "#FFFFFF",
        "marginBottom": 5,
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        {
          "type": "text",
          "text": "功能启动",
          "style": { "fontSize": 12, "color": "#7A8A88" }
        },
        {
          "type": "row",
          "style": { "valign": "center", "gap": 4 },
          "children": [
            {
              "type": "checkbox",
              "name": "agreeProtocol",
              "label": "我已阅读并同意",
              "onChange": "onAgreeChange",
              "style": { "color": "#0B6E6A" }
            },
            {
              "type": "text",
              "text": "《用户协议》",
              "onTap": "onOpenProtocol",
              "style": { "fontSize": 13, "color": "#0B6E6A", "fontWeight": "bold" }
            }
          ]
        },
        {
          "type": "button",
          "text": "开始运行",
          "size": "md",
          "onTap": "onRun",
          "style": { "background": "#0B6E6A", "color": "#FFFFFF", "radius": 10, "width": "100%" }
        },
        {
          "type": "notice",
          "text": "运行前自动检查激活、适配与权限",
          "style": { "color": "#7A8A88" }
        }
      ]
    },
    {
      "type": "card",
      "showIf": "showTargetCard",
      "style": {
        "padding": 10,
        "gap": 6,
        "radius": 12,
        "background": "#FFFFFF",
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        {
          "type": "text",
          "text": "目标应用",
          "style": { "fontSize": 12, "color": "#7A8A88" }
        },
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            { "type": "text", "text": "{{targetTitle}}", "style": { "weight": 1, "fontWeight": "bold", "fontSize": 15, "color": "#1A2B2A" } },
            {
              "type": "tag",
              "text": "{{targetTag}}",
              "style": { "background": "{{targetTagBg}}", "color": "{{targetTagColor}}", "radius": 4 }
            }
          ]
        },
        { "type": "notice", "text": "{{targetDetail}}" },
        {
          "type": "notice",
          "text": "请关闭应用市场自动更新，避免版本自动升级",
          "style": { "color": "#8A5A20" }
        },
        {
          "type": "button",
          "text": "查看支持版本与下载",
          "size": "sm",
          "onTap": "onGoTarget",
          "style": { "background": "#F3F7F6", "color": "#0B6E6A", "radius": 8, "width": "100%" }
        }
      ]
    },
    {
      "type": "dialog",
      "showIf": "agreeTipOpen",
      "title": "提示",
      "text": "请勾选用户协议",
      "confirmText": "知道了",
      "hideCancel": true,
      "onConfirm": "onCloseAgreeTip",
      "style": { "color": "#0B6E6A" }
    },
    {
      "type": "dialog",
      "showIf": "paramsDialogOpen",
      "title": "请先完成设置",
      "text": "请先到「设置」填写视频搜索关键词和评论关键词。",
      "confirmText": "去设置",
      "cancelText": "取消",
      "onConfirm": "onGoParams",
      "onCancel": "onCloseParamsDialog",
      "style": { "color": "#0B6E6A" }
    },
    {
      "type": "dialog",
      "showIf": "payDialogOpen",
      "title": "未激活提醒",
      "text": "{{payDialogText}}",
      "confirmText": "去激活",
      "cancelText": "取消",
      "onConfirm": "onGoPay",
      "onCancel": "onClosePayDialog",
      "style": { "color": "#0B6E6A" }
    },
    {
      "type": "dialog",
      "showIf": "stopHintOpen",
      "title": "运行提示",
      "text": "运行后屏幕顶部会出现运行条，点右侧停止图标结束本次任务。请勿强制关闭 App。",
      "confirmText": "确认并开始",
      "cancelText": "取消",
      "closeOnMask": false,
      "onConfirm": "onConfirmStopHint",
      "onCancel": "onCancelStopHint",
      "style": { "color": "#0B6E6A" }
    }
  ],
  "popups": [
    {
      "showIf": "targetDialogOpen",
      "position": "center",
      "width": "88%",
      "closeOnMask": false,
      "style": {
        "radius": 14,
        "background": "#FFFFFF",
        "padding": 16,
        "gap": 10,
        "height": "wrap"
      },
      "body": [
        {
          "type": "text",
          "text": "请先安装适配 App",
          "style": {
            "fontWeight": "bold",
            "fontSize": 16,
            "color": "#1A2B2A",
            "align": "center"
          }
        },
        {
          "type": "text",
          "text": "{{targetDialogText}}",
          "style": {
            "fontSize": 14,
            "color": "#334443"
          }
        },
        {
          "type": "checkbox",
          "name": "dismissTargetRemind",
          "label": "不再提醒",
          "onChange": "onDismissTargetRemind",
          "style": {
            "color": "#0B6E6A"
          }
        },
        {
          "type": "row",
          "style": {
            "gap": 8
          },
          "children": [
            {
              "type": "button",
              "text": "仍要运行",
              "size": "sm",
              "onTap": "onContinueDespiteTarget",
              "style": {
                "background": "#F3F7F6",
                "color": "#334443",
                "radius": 10,
                "weight": 1
              }
            },
            {
              "type": "button",
              "text": "去下载",
              "size": "sm",
              "onTap": "onGoTarget",
              "style": {
                "background": "#0B6E6A",
                "color": "#FFFFFF",
                "radius": 10,
                "weight": 1
              }
            }
          ]
        }
      ]
    },
    {
      "showIf": "protocolOpen",
      "position": "center",
      "width": "88%",
      "style": { "radius": 14, "background": "#FFFFFF", "padding": 10, "gap": 6, "height": "wrap" },
      "body": [
        {
          "type": "row",
          "style": { "valign": "center" },
          "children": [
            { "type": "space", "style": { "width": 22 } },
            {
              "type": "text",
              "text": "用户协议",
              "style": { "weight": 1, "fontWeight": "bold", "fontSize": 16, "color": "#1A2B2A", "align": "center" }
            },
            {
              "type": "image",
              "src": "img/close.svg",
              "onTap": "onCloseProtocol",
              "style": { "width": 22, "height": 22 }
            }
          ]
        },
        {
          "type": "webview",
          "html": "{{protocolHtml}}",
          "javascript": false,
          "style": { "height": 280, "radius": 8 }
        },
        {
          "type": "button",
          "text": "我已阅读",
          "size": "sm",
          "onTap": "onCloseProtocol",
          "style": { "background": "#0B6E6A", "color": "#FFFFFF", "width": "100%", "radius": 8 }
        }
      ]
    },
    {
      "showIf": "guideOpen",
      "position": "center",
      "width": "88%",
      "style": { "radius": 14, "background": "#FFFFFF", "padding": 10, "gap": 6, "height": "wrap" },
      "body": [
        {
          "type": "accessGuide",
          "id": "accessGuide",
          "onClose": "onCloseGuide",
          "style": { "width": "100%" }
        }
      ]
    },
    {
      "showIf": "updateOpen",
      "position": "center",
      "title": "{{updateTitle}}",
      "width": "88%",
      "closeOnMask": false,
      "style": { "radius": 14, "background": "#FFFFFF", "padding": 10 },
      "body": [
        {
          "type": "updateDialog",
          "id": "updateDialog",
          "onSkip": "onSkipUpdate",
          "onClose": "onCloseUpdate"
        }
      ]
    }
  ]
}
