{
  "title": {
    "text": "工作台",
    "fontSize": 17,
    "color": "#FFFFFF",
    "background": "#0B6E6A"
  },
  "style": {
    "background": "#F3F6F5",
    "padding": 12
  },
  "body": [
    {
      "type": "card",
      "style": { "padding": 14, "gap": 8, "radius": 14, "background": "#FFFFFF", "marginBottom": 4 },
      "children": [
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            { "type": "text", "text": "{{statusTitle}}", "style": { "weight": 1, "fontWeight": "bold", "fontSize": 17 } },
            { "type": "tag", "text": "{{statusTag}}", "style": { "background": "{{statusTagBg}}", "color": "{{statusTagColor}}", "radius": 6 } }
          ]
        },
        { "type": "notice", "text": "{{statusDetail}}" },
        {
          "type": "button",
          "text": "去激活",
          "showIf": "showPayEntry",
          "size": "sm",
          "onTap": "onGoPay",
          "style": { "background": "#E8F6F4", "color": "#0B6E6A", "radius": 8 }
        }
      ]
    },
    {
      "type": "card",
      "showIf": "showTargetCard",
      "style": { "padding": 14, "gap": 8, "radius": 14, "background": "#FFFFFF", "marginBottom": 12 },
      "children": [
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            { "type": "text", "text": "{{targetTitle}}", "style": { "weight": 1, "fontWeight": "bold", "fontSize": 15 } },
            {
              "type": "tag",
              "text": "{{targetTag}}",
              "style": { "background": "{{targetTagBg}}", "color": "{{targetTagColor}}", "radius": 6 }
            }
          ]
        },
        { "type": "notice", "text": "{{targetSummary}}" },
        { "type": "notice", "text": "{{targetDetail}}" },
        {
          "type": "notice",
          "text": "建议关闭应用市场对该 App 的自动更新，避免版本变化导致脚本失效",
          "style": { "color": "#A35B00" }
        },
        {
          "type": "button",
          "text": "查看支持版本与下载",
          "size": "sm",
          "onTap": "onGoTarget",
          "style": { "background": "#F0F4F3", "color": "#0B6E6A", "radius": 8, "width": "100%" }
        }
      ]
    },
    {
      "type": "row",
      "style": { "valign": "center", "gap": 4, "marginBottom": 8 },
      "children": [
        {
          "type": "checkbox",
          "name": "agreeProtocol",
          "label": "我已阅读并同意",
          "onChange": "onAgreeChange",
          "style": { "color": "#0B6E6A" }
        },
        {
          "type": "text",
          "text": "《用户协议》",
          "onTap": "onOpenProtocol",
          "style": { "fontSize": 13, "color": "#0B6E6A" }
        }
      ]
    },
    {
      "type": "button",
      "text": "开始运行",
      "onTap": "onRun",
      "style": { "background": "#0B6E6A", "color": "#FFFFFF", "radius": 12, "width": "100%" }
    },
    {
      "type": "dialog",
      "showIf": "agreeTipOpen",
      "title": "提示",
      "text": "请勾选用户协议",
      "confirmText": "知道了",
      "hideCancel": true,
      "onConfirm": "onCloseAgreeTip",
      "style": { "color": "#0B6E6A" }
    },
    {
      "type": "dialog",
      "showIf": "paramsDialogOpen",
      "title": "请先完成设置",
      "text": "首次运行前请到「设置」页完成配置并保存。",
      "confirmText": "去设置",
      "cancelText": "取消",
      "onConfirm": "onGoParams",
      "onCancel": "onCloseParamsDialog",
      "style": { "color": "#0B6E6A" }
    },
    {
      "type": "dialog",
      "showIf": "payDialogOpen",
      "title": "未激活提醒",
      "text": "{{payDialogText}}",
      "confirmText": "去激活",
      "cancelText": "取消",
      "onConfirm": "onGoPay",
      "onCancel": "onClosePayDialog",
      "style": { "color": "#0B6E6A" }
    },
    {
      "type": "dialog",
      "showIf": "targetDialogOpen",
      "title": "请先安装适配 App",
      "text": "{{targetDialogText}}",
      "confirmText": "去下载",
      "cancelText": "仍要运行",
      "onConfirm": "onGoTarget",
      "onCancel": "onContinueDespiteTarget",
      "style": { "color": "#0B6E6A" }
    }
  ],
  "popups": [
    {
      "showIf": "protocolOpen",
      "position": "center",
      "width": "88%",
      "style": { "radius": 14, "background": "#FFFFFF", "padding": 12, "gap": 10, "height": "wrap" },
      "body": [
        {
          "type": "row",
          "style": { "valign": "center" },
          "children": [
            { "type": "space", "style": { "width": 22 } },
            {
              "type": "text",
              "text": "用户协议",
              "style": { "weight": 1, "fontWeight": "bold", "fontSize": 16, "color": "#223", "align": "center" }
            },
            {
              "type": "image",
              "src": "img/close.svg",
              "onTap": "onCloseProtocol",
              "style": { "width": 22, "height": 22 }
            }
          ]
        },
        {
          "type": "webview",
          "html": "{{protocolHtml}}",
          "javascript": false,
          "style": { "height": 280, "radius": 8 }
        },
        {
          "type": "button",
          "text": "我已阅读",
          "size": "sm",
          "onTap": "onCloseProtocol",
          "style": { "background": "#0B6E6A", "color": "#FFFFFF", "width": "100%", "radius": 8 }
        }
      ]
    },
    {
      "showIf": "guideOpen",
      "position": "center",
      "width": "88%",
      "style": { "radius": 14, "background": "#FFFFFF", "padding": 12, "gap": 10, "height": "wrap" },
      "body": [
        {
          "type": "row",
          "style": { "valign": "center" },
          "children": [
            { "type": "space", "style": { "width": 22 } },
            {
              "type": "text",
              "text": "如何开启无障碍",
              "style": { "weight": 1, "fontWeight": "bold", "fontSize": 16, "color": "#223", "align": "center" }
            },
            {
              "type": "image",
              "src": "img/close.svg",
              "onTap": "onCloseGuide",
              "style": { "width": 22, "height": 22 }
            }
          ]
        },
        {
          "type": "column",
          "style": { "background": "#FFFFFF", "radius": 10, "padding": 10, "gap": 8, "borderWidth": 1, "borderColor": "#E6EEEE" },
          "children": [
            {
              "type": "text",
              "text": "已下载的应用",
              "style": { "fontSize": 14, "fontWeight": "bold", "color": "#223", "align": "left" }
            },
            {
              "type": "row",
              "style": { "valign": "center", "gap": 8, "background": "#F7FAF9", "radius": 8, "padding": 10 },
              "children": [
                {
                  "type": "text",
                  "text": "{{guideAppName}}",
                  "style": { "weight": 1, "fontSize": 14, "fontWeight": "bold", "color": "#223" }
                },
                {
                  "type": "text",
                  "text": "已关闭 >",
                  "style": { "fontSize": 13, "color": "#889999" }
                }
              ]
            }
          ]
        },
        {
          "type": "button",
          "text": "去打开",
          "size": "sm",
          "onTap": "onOpenAccessibility",
          "style": { "background": "#0B6E6A", "color": "#FFFFFF", "width": "100%", "radius": 8 }
        }
      ]
    },
    {
      "showIf": "updateOpen",
      "position": "center",
      "title": "{{updateTitle}}",
      "width": "88%",
      "closeOnMask": false,
      "style": { "radius": 14, "background": "#FFFFFF" },
      "body": [
        { "type": "notice", "text": "{{updateVersionLine}}" },
        { "type": "notice", "text": "{{updateSizeLine}}", "showIf": "hasUpdateSize" },
        { "type": "space", "height": 6 },
        { "type": "text", "text": "{{updateChangelog}}", "style": { "fontSize": 13, "color": "#334" } },
        { "type": "space", "height": 10 },
        {
          "type": "row",
          "style": { "gap": 8 },
          "children": [
            {
              "type": "button",
              "text": "以后再说",
              "size": "sm",
              "showIf": "canSkipUpdate",
              "onTap": "onSkipUpdate",
              "style": { "weight": 1, "background": "#F0F4F3", "color": "#445" }
            },
            {
              "type": "button",
              "text": "{{updateConfirmText}}",
              "size": "sm",
              "onTap": "onDoUpdate",
              "style": { "weight": 1, "background": "#0B6E6A", "color": "#FFFFFF" }
            }
          ]
        }
      ]
    }
  ]
}
