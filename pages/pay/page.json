{
  "title": {
    "hidden": true
  },
  "style": {
    "background": "#EEF2F1",
    "padding": 0
  },
  "body": [
    {
      "type": "column",
      "style": { "sticky": "top", "background": "#0B6E6A", "padding": 10 },
      "children": [
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            {
              "type": "image",
              "src": "img/back.svg",
              "onTap": "onBack",
              "style": { "width": 26, "height": 26 }
            },
            {
              "type": "text",
              "text": "激活APP",
              "style": { "weight": 1, "color": "#FFFFFF", "fontSize": 17, "fontWeight": "bold", "align": "center" }
            },
            {
              "type": "image",
              "src": "img/menu.svg",
              "onTap": "onOpenActivate",
              "style": { "width": 26, "height": 26 }
            }
          ]
        }
      ]
    },
    {
      "type": "column",
      "style": { "padding": 10, "gap": 8 },
      "children": [
        {
          "type": "card",
          "style": {
            "padding": 10,
            "gap": 4,
            "radius": 12,
            "background": "#E8F6F4",
            "borderWidth": 1,
            "borderColor": "#D5EBE8"
          },
          "children": [
            { "type": "text", "text": "售后保障", "style": { "fontWeight": "bold", "fontSize": 13, "color": "#0B6E6A" } },
            { "type": "notice", "text": "有任何问题，请24小时内联系客服！" }
          ]
        },
        {
          "type": "card",
          "showIf": "isFree",
          "style": { "padding": 10, "gap": 4, "radius": 12, "background": "#E8F6F4", "borderWidth": 1, "borderColor": "#D5EBE8" },
          "children": [
            { "type": "title", "text": "免费使用", "style": { "color": "#0B6E6A" } },
            { "type": "notice", "text": "{{freeHint}}" }
          ]
        },
        {
          "type": "list",
          "bind": "plans",
          "showIf": "showPlans",
          "style": { "gap": 4 },
          "item": {
            "type": "card",
            "onTap": "onSelectPlan",
            "style": {
              "padding": 10,
              "radius": 12,
              "background": "{{item.cardBg}}",
              "borderColor": "{{item.borderColor}}",
              "borderWidth": 1
            },
            "children": [
              {
                "type": "row",
                "style": { "valign": "center", "gap": 8 },
                "children": [
                  {
                    "type": "column",
                    "style": { "weight": 1, "gap": 2 },
                    "children": [
                      { "type": "text", "text": "{{item.name}}", "style": { "fontWeight": "bold", "fontSize": 15, "color": "#1A2B2A" } },
                      { "type": "notice", "text": "{{item.sub}}" }
                    ]
                  },
                  { "type": "text", "text": "{{item.priceText}}", "style": { "color": "#0B6E6A", "fontWeight": "bold", "fontSize": 18 } }
                ]
              }
            ]
          }
        },
        { "type": "empty", "text": "暂无可用套餐", "showIf": "plansEmpty" },
        { "type": "space", "height": 12 }
      ]
    },
    {
      "type": "column",
      "showIf": "showPayActions",
      "style": {
        "sticky": "bottom",
        "padding": 10,
        "gap": 8,
        "background": "#FFFFFF",
        "borderTopWidth": 1,
        "borderTopColor": "#E2EAEA"
      },
      "children": [
        { "type": "notice", "text": "已选：{{selectedPlanName}} · ¥{{selectedPrice}}" },
        {
          "type": "notice",
          "showIf": "hasSelectedCouponLine",
          "text": "{{selectedCouponLine}}",
          "style": { "color": "#0B6E6A" }
        },
        {
          "type": "column",
          "showIf": "showCouponBox",
          "style": { "gap": 4 },
          "children": [
            {
              "type": "row",
              "style": { "valign": "center", "gap": 6 },
              "children": [
                {
                  "type": "input",
                  "name": "couponCode",
                  "hint": "优惠码",
                  "variant": "box",
                  "size": "sm",
                  "style": { "weight": 1, "radius": 8 }
                },
                {
                  "type": "button",
                  "text": "使用",
                  "size": "sm",
                  "showIf": "showCouponApply",
                  "onTap": "onApplyCoupon",
                  "style": { "background": "#0B6E6A", "color": "#FFFFFF", "radius": 8, "paddingLeft": 12, "paddingRight": 12 }
                },
                {
                  "type": "button",
                  "text": "清除",
                  "size": "sm",
                  "showIf": "showCouponClear",
                  "onTap": "onClearCoupon",
                  "style": { "background": "#F3F7F6", "color": "#556", "radius": 8, "paddingLeft": 12, "paddingRight": 12 }
                }
              ]
            },
            {
              "type": "notice",
              "showIf": "hasCouponHint",
              "text": "{{couponHint}}",
              "style": { "color": "#0B6E6A" }
            }
          ]
        },
        {
          "type": "button",
          "text": "支付宝支付",
          "size": "md",
          "onTap": "onPayApp",
          "style": { "background": "#1677FF", "color": "#FFFFFF", "radius": 10, "width": "100%" }
        },
        {
          "type": "button",
          "text": "支付宝扫码支付",
          "size": "md",
          "onTap": "onPayQr",
          "style": { "background": "#0B6E6A", "color": "#FFFFFF", "radius": 10, "width": "100%" }
        },
        {
          "type": "button",
          "text": "模拟支付（仅开发环境）",
          "size": "sm",
          "showIf": "showMock",
          "onTap": "onPayMock",
          "style": { "background": "#F3F7F6", "color": "#556", "width": "100%", "radius": 8 }
        }
      ]
    }
  ],
  "popups": [
    {
      "showIf": "activateOpen",
      "position": "bottom",
      "title": "激活码",
      "style": { "radius": 16, "background": "#FFFFFF", "padding": 10 },
      "body": [
        {
          "type": "column",
          "showIf": "showActivateCode",
          "style": { "gap": 8, "paddingTop": 12 },
          "children": [
            { "type": "notice", "text": "{{activateBoundHint}}" },
            {
              "type": "text",
              "text": "{{savedActivationCode}}",
              "style": { "fontSize": 18, "fontWeight": "bold", "color": "#0B6E6A", "align": "center" }
            },
            {
              "type": "button",
              "text": "复制激活码",
              "size": "sm",
              "onTap": "onCopyActivateCode",
              "style": { "background": "#0B6E6A", "color": "#FFFFFF", "radius": 10, "width": "100%" }
            }
          ]
        },
        {
          "type": "column",
          "showIf": "showActivateForm",
          "style": { "gap": 8, "paddingTop": 12 },
          "children": [
            { "type": "notice", "text": "如果你有激活码，可以使用激活码直接激活" },
            {
              "type": "input",
              "name": "activationCode",
              "hint": "请输入激活码",
              "variant": "box"
            },
            {
              "type": "notice",
              "showIf": "activateTip",
              "text": "{{activateTip}}",
              "style": { "color": "#B42318" }
            },
            {
              "type": "button",
              "text": "立即激活",
              "onTap": "onActivateCode",
              "style": { "background": "#0B6E6A", "color": "#FFFFFF", "radius": 10, "width": "100%" }
            }
          ]
        }
      ]
    },
    {
      "showIf": "qrOpen",
      "position": "center",
      "width": "86%",
      "style": { "radius": 14, "background": "#FFFFFF", "padding": 10, "gap": 6, "height": "wrap", "align": "center" },
      "body": [
        {
          "type": "row",
          "style": { "valign": "center", "width": "100%" },
          "children": [
            { "type": "space", "style": { "width": 22 } },
            {
              "type": "text",
              "text": "支付宝扫码支付",
              "style": { "weight": 1, "fontWeight": "bold", "fontSize": 16, "color": "#223", "align": "center" }
            },
            {
              "type": "image",
              "src": "img/close.svg",
              "onTap": "onCloseQr",
              "style": { "width": 22, "height": 22 }
            }
          ]
        },
        {
          "type": "column",
          "style": { "align": "center", "width": "100%", "gap": 8 },
          "children": [
            {
              "type": "image",
              "src": "{{qrImage}}",
              "fit": "contain",
              "style": { "width": 200, "height": 200, "radius": 8 }
            },
            {
              "type": "notice",
              "text": "{{qrStatus}}",
              "style": { "align": "center", "color": "#667" }
            }
          ]
        },
        {
          "type": "button",
          "text": "我已支付",
          "size": "sm",
          "onTap": "onCheckOrder",
          "style": { "background": "#0B6E6A", "color": "#FFFFFF", "width": "100%", "radius": 8 }
        }
      ]
    }
  ]
}
