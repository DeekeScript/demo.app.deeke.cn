{
  "style": {
    "padding": 0,
    "background": "#00000000"
  },
  "body": [
    {
      "type": "row",
      "style": {
        "gap": 6,
        "background": "#FF2442",
        "radius": 999,
        "paddingLeft": 8,
        "paddingRight": 6,
        "paddingTop": 2,
        "paddingBottom": 2
      },
      "children": [
        {
          "type": "text",
          "text": "●",
          "style": {
            "color": "#FFFFFF",
            "fontSize": 10,
            "opacity": "{{dotOpacity}}"
          }
        },
        {
          "type": "text",
          "text": "{{title}}",
          "style": {
            "color": "#FFFFFF",
            "fontSize": 11,
            "weight": 1,
            "width": 0,
            "lines": 1
          }
        },
        {
          "type": "image",
          "src": "img/stop.svg",
          "onTap": "onStop",
          "style": {
            "width": 16,
            "height": 16
          }
        }
      ]
    }
  ]
}
