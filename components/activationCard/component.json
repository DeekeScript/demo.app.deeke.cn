{
  "component": true,
  "id": "activationCard",
  "body": [
    {
      "type": "card",
      "style": {
        "padding": 12,
        "gap": 8,
        "radius": 16,
        "background": "#FFFFFF",
        "marginBottom": 8,
        "borderWidth": 1,
        "borderColor": "#E2EAEA"
      },
      "children": [
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            {
              "type": "column",
              "style": {
                "width": 28,
                "height": 28,
                "radius": 8,
                "background": "#0B6E6A",
                "align": "center",
                "valign": "center"
              },
              "children": [
                { "type": "image", "src": "img/ic_shield.svg", "style": { "width": 16, "height": 16 } }
              ]
            },
            {
              "type": "text",
              "text": "激活状态",
              "style": { "fontSize": 14, "fontWeight": "bold", "color": "#1A2B2A" }
            }
          ]
        },
        {
          "type": "row",
          "style": { "valign": "center", "gap": 8 },
          "children": [
            {
              "type": "text",
              "text": "{{statusTitle}}",
              "style": { "weight": 1, "fontWeight": "bold", "fontSize": 16, "color": "#1A2B2A" }
            },
            {
              "type": "button",
              "text": "去激活",
              "showIf": "showPayEntry",
              "size": "sm",
              "onTap": "onGoPay",
              "style": { "background": "#E8F6F4", "color": "#0B6E6A", "radius": 8 }
            }
          ]
        },
        { "type": "notice", "text": "{{statusDetail}}" }
      ]
    }
  ]
}
