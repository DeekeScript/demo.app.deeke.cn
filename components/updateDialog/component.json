{
  "component": true,
  "id": "updateDialog",
  "body": [
    { "type": "notice", "text": "{{updateVersionLine}}", "style": { "fontSize": 15, "color": "#1A2B2A" } },
    { "type": "notice", "text": "{{updateSizeLine}}", "showIf": "hasUpdateSize", "style": { "fontSize": 15, "color": "#1A2B2A" } },
    { "type": "text", "text": "{{updateChangelog}}", "showIf": "hasChangelog", "style": { "fontSize": 14, "color": "#334443" } },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        {
          "type": "button",
          "text": "以后再说",
          "size": "sm",
          "showIf": "canSkipUpdate",
          "onTap": "onSkipUpdate",
          "style": { "weight": 1, "background": "#F3F7F6", "color": "#445", "radius": 8 }
        },
        {
          "type": "button",
          "text": "{{updateConfirmText}}",
          "size": "sm",
          "onTap": "onDoUpdate",
          "style": { "weight": 1, "background": "#0B6E6A", "color": "#FFFFFF", "radius": 8 }
        }
      ]
    }
  ]
}
